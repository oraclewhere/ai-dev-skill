{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/inject-context.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-commit.sh",
            "timeout": 15,
            "statusMessage": "校验提交是否关联任务记录…"
          },
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/log-event.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git merge *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-merge.sh",
            "timeout": 15,
            "statusMessage": "校验合并是否关联交付件…"
          },
          {
            "type": "command",
            "if": "Bash(git merge *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/log-event.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git checkout *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-branch.sh",
            "timeout": 15,
            "statusMessage": "校验分支名是否关联任务记录…"
          },
          {
            "type": "command",
            "if": "Bash(git switch *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-branch.sh",
            "timeout": 15,
            "statusMessage": "校验分支名是否关联任务记录…"
          },
          {
            "type": "command",
            "if": "Bash(git branch *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-branch.sh",
            "timeout": 15,
            "statusMessage": "校验分支名是否关联任务记录…"
          },
          {
            "type": "command",
            "if": "Bash(git checkout *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/log-event.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-irreversible.sh",
            "timeout": 15,
            "statusMessage": "校验是否触碰不可逆动作…"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/log-event.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-queue.sh",
            "timeout": 15,
            "statusMessage": "校验队列项完整性…"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-role-boundaries.sh",
            "timeout": 15,
            "statusMessage": "校验角色边界…"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/log-event.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/precompact-snapshot.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-handoff.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}